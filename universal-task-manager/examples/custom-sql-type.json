{
  "type_id": "custom-sql",
  "name": "自定义 SQL 采集",
  "description": "通过自定义 SQL 查询采集业务指标，适用于私有数据库或特殊业务场景",
  "source_type": "database",
  "collector": "custom",

  "form_schema": {
    "fields": [
      {
        "key": "database_type",
        "label": "数据库类型",
        "type": "select",
        "options": ["mysql", "postgresql", "oracle", "sqlserver"],
        "default": "mysql",
        "required": true,
        "group": "数据库配置"
      },
      {
        "key": "query",
        "label": "SQL 查询语句",
        "type": "textarea",
        "required": true,
        "placeholder": "SELECT value, timestamp FROM metrics WHERE ...",
        "help": "查询必须返回 value 和 timestamp 两列。可选返回 labels 列作为指标标签。",
        "group": "查询配置"
      },
      {
        "key": "scrape_interval",
        "label": "采集间隔",
        "type": "select",
        "options": ["30s", "60s", "5m", "15m", "30m"],
        "default": "60s",
        "required": true,
        "group": "采集配置"
      },
      {
        "key": "query_timeout",
        "label": "查询超时",
        "type": "select",
        "options": ["10s", "30s", "60s", "120s"],
        "default": "30s",
        "group": "采集配置"
      },
      {
        "key": "metric_name",
        "label": "产出指标名",
        "type": "text",
        "required": true,
        "placeholder": "my_custom_metric",
        "help": "遵循 Prometheus 命名规范: <namespace>_<subsystem>_<name>",
        "group": "指标配置"
      },
      {
        "key": "metric_type",
        "label": "指标类型",
        "type": "select",
        "options": ["gauge", "counter"],
        "default": "gauge",
        "group": "指标配置"
      },
      {
        "key": "metric_help",
        "label": "指标说明",
        "type": "text",
        "placeholder": "指标用途说明",
        "group": "指标配置"
      },
      {
        "key": "default_labels",
        "label": "默认标签",
        "type": "json",
        "default": "{}",
        "help": "JSON 格式的标签键值对，会附加到每个指标样本",
        "group": "指标配置"
      },
      {
        "key": "null_handling",
        "label": "空值处理",
        "type": "select",
        "options": ["skip", "zero", "error"],
        "default": "skip",
        "help": "skip: 跳过空值; zero: 视为0; error: 报错",
        "group": "高级配置"
      }
    ]
  },

  "detail_panels": [
    {
      "key": "query_info",
      "title": "查询信息",
      "type": "info",
      "fields": ["database_type", "query", "scrape_interval", "query_timeout"]
    },
    {
      "key": "metric_info",
      "title": "指标信息",
      "type": "info",
      "fields": ["metric_name", "metric_type", "metric_help", "default_labels"]
    },
    {
      "key": "execution_log",
      "title": "执行日志",
      "type": "log_viewer"
    },
    {
      "key": "sample_data",
      "title": "样本数据",
      "type": "info",
      "display": "table"
    }
  ],

  "declared_metrics": [
    {
      "name": "{{config.metric_name}}",
      "type": "{{config.metric_type}}",
      "help": "{{config.metric_help}}"
    }
  ],

  "config_template": {
    "custom": {
      "type": "sql_collector",
      "database_type": "{{config.database_type}}",
      "query": "{{config.query}}",
      "interval": "{{config.scrape_interval}}",
      "timeout": "{{config.query_timeout}}",
      "output": {
        "metric_name": "{{config.metric_name}}",
        "metric_type": "{{config.metric_type}}",
        "default_labels": "{{config.default_labels}}"
      },
      "null_handling": "{{config.null_handling}}"
    }
  }
}
